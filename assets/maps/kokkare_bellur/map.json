xit":"LEFT","dir":"RIGHT"},{"id":"E1","x":37,"y":16,"to":"ramanagara","toId":"W1","exit":"LEFT","dir":"RIGHT"}],"npcs":[{"id":"kb_ajji","x":7,"y":14,"sprite":"ajji","facing":"DOWN","movement":"IDLE","script":[{"say":["The kokkare come every winter and nest on our roofs. We never chase them away.","They bring luck, and their droppings make the best fertiliser in Karnataka. Both are true!"]}]},{"id":"kb_farmer","x":9,"y":21,"sprite":"man2","facing":"DOWN","movement":"IDLE","script":[{"say":["Ragi on the high fields, paddy down here. The storks walk behind my plough and eat the frogs.","Free pest control. The government should give them a salary."]}]},{"id":"kb_kid","x":20,"y":13,"sprite":"kid1","facing":"DOWN","movement":"WANDER","wanderRadius":1,"script":[{"say":"I counted forty-two pelicans this morning! Then one sat on my head and I lost count."}]},{"id":"kb_volunteer","x":24,"y":16,"sprite":"college_f","facing":"DOWN","movement":"IDLE","script":[{"say":["I'm counting nests for the bird survey. The village does most of the work, honestly.","Nobody here has ever chased a stork off a roof. That's why they keep coming back."]}]},{"id":"kb_fisher","x":25,"y":23,"sprite":"fisher","facing":"RIGHT","movement":"IDLE","script":[{"say":"The pelicans and I fish the same pond. They're better at it. I've made my peace with that."}]}],"signs":[{"x":34,"y":17,"text":"KOKKARE BELLUR - Village of the storks. Please don't disturb the nests, or the grandmothers."},{"x":21,"y":17,"style":"board","text":"NESTING SEASON: December to May. Pelicans and painted storks fish in this pond every day. Keep your Urumon calm."}],"items":[{"id":"kb_elaneer","x":2,"y":13,"item":"Elaneer","qty":2},{"id":"kb_mudde","x":34,"y":11,"item":"Ragi Mudde"}],"triggers":[],"counters":[],"interactables":[],"encounters":{"grass":{"rate":0.12,"slots":[{"species":127,"min":45,"max":50,"weight":16},{"species":126,"min":44,"max":46,"weight":10},{"species":29,"min":45,"max":49,"weight":10},{"species":73,"min":45,"ma
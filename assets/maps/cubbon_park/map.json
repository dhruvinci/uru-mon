say":["Some people in hard hats walked in with chainsaws this morning. Said they were 'developers'.","I'm just a park ranger... could you check on them, up by the north gate?"],"speaker":"Park Ranger"}]}]},{"id":"cp_bandsman","x":9,"y":11,"sprite":"ajja","facing":"UP","movement":"IDLE","script":[{"say":["The police band plays here every Sunday. Same five songs since 1978. I know all the words.","There are no words. I know them anyway."]}]},{"id":"cp_reader","x":25,"y":11,"sprite":"college_f","facing":"UP","movement":"IDLE","script":[{"say":["The library has a book on every Urumon ever recorded. Except the ones from the old cave up north.","Nobody's been in there for years. Well. Nobody nice."]}]},{"id":"cp_kid_play","x":12,"y":42,"sprite":"kid1","facing":"DOWN","movement":"WANDER","wanderRadius":1,"script":[{"say":"I went down the slide forty times. FORTY. Amma says one more and we go home. I'm never going home."}]},{"id":"cp_yoga","x":22,"y":36,"sprite":"woman1","facing":"UP","movement":"IDLE","script":[{"say":["Laughter yoga. HA. HA. HA. HA.","...It works. My Urumon thinks I've gone mad, but it works."]}]}],"signs":[{"x":19,"y":44,"text":"CUBBON PARK - 300 acres of green in the heart of the city. Please keep it that way."},{"x":12,"y":9,"text":"THE BANDSTAND - Free concerts every Sunday morning. Urumon choir rehearsals on Tuesdays."},{"x":20,"y":8,"text":"STATE CENTRAL LIBRARY - Quiet, please. (The squirrels never listen.)"},{"x":14,"y":8,"style":"board","text":"CONCRETE SYNDICATE - 'TREE TRIMMING' IN PROGRESS. Permit No. 0000001. (Totally genuine.)"}],"items":[{"id":"dabba1","x":16,"y":45,"item":"Dabba","qty":3},{"id":"kaapi1","x":31,"y":15,"item":"Filter Kaapi","qty":2},{"id":"neem1","x":7,"y":16,"item":"Neem Paste"},{"id":"pak1","x":28,"y":3,"item":"Mysore Pak"}],"triggers":[],"counters":[],"interactables":[],"encounters":{"grass":{"rate":0.13,"slots":[{"species":15,"min":6,"max":9,"weight":16},{"species":18,"min":6,"max":9,"weight":12},{"species":85,"min":7,"m
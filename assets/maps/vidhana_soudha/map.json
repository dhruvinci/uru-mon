:"DOWN","movement":"IDLE","script":[{"say":["Beyond these doors wait the four councillors of the Namma Council, and the Champion.","Once you go in, there's no walking out until you win - or lose."],"speaker":"Guard"}]},{"id":"vs_prof","x":24,"y":18,"sprite":"professor","facing":"LEFT","movement":"IDLE","script":[{"if":"CHAMPION_DONE","then":[{"say":["Champion {PLAYER}! The lakes are clearing, the trees are growing back. And it started with you.","Go anywhere. Catch everything. The city is yours to explore."],"speaker":"Prof. Sharada"}],"else":[{"say":["{PLAYER}! Six badges! Sudeep is already inside, you know. He left about an hour ago.","Rest at the Darshini first. The Council doesn't hold back."],"speaker":"Prof. Sharada"}]}]},{"id":"vs_tourist","x":23,"y":12,"sprite":"college_m","facing":"UP","movement":"IDLE","script":[{"say":"Every evening they light up the whole building. I've taken four hundred photos. They're all the same photo."}]},{"id":"vs_guard2","x":21,"y":11,"sprite":"officer","facing":"DOWN","movement":"IDLE","script":[{"say":["Those two-headed birds carved over the doors? The Gandaberunda. Old royal emblem.","Some nights I could swear one of the heads turns to look at me."],"speaker":"Guard"}]},{"id":"vs_lawyer","x":9,"y":27,"sprite":"man3","facing":"UP","movement":"IDLE","script":[{"say":"My case has been in that court for twenty-two years. Next hearing: next month. It's always next month."}]}],"signs":[{"x":22,"y":14,"text":"VIDHANA SOUDHA - Seat of the Namma Council. 'Government's work is God's work.'"},{"x":12,"y":26,"style":"stone","text":"ATTARA KACHERI - The old red court of eighteen offices. Still arguing, after all these years."}],"items":[],"triggers":[{"id":"gandaberunda","once":false,"x":18,"y":11,"w":2,"h":1,"requires":"CHAMPION_DONE","unless":"GANDA_DONE","script":[{"cutscene":true},{"say":"The great seal above the doors begins to glow."},{"say":"Two crowned heads turn towards you. The emblem of the old kingdom spreads its wings!"},{"cutscene":false},{"battle":{"wild":{"species":146,"level":60},"music":"MUSIC_LEGEND","environment":"city"},"onWin":[{"setFlag":"GANDA_DONE"},{"if":{"caught":146},"then":[{"say":"Gandaberunda bows both heads. It will protect the land at your side."}],"else":[{"say":"Gandaberunda soars over the dome and fades into the seal."}]}],"onLose":[]}]},{"id":"gandaberunda","once":false,"x":20,"y":11,"w":2,"h":1,"requires":"CHAMPION_DONE","unless":"GANDA_DONE","script":[{"cutscene":true},{"say":"The great seal above the doors begins to glow."},{"say":"Two crowned heads turn towards you. The emblem of the old kingdom spreads its wings!"},{"cutscene":false},{"battle":{"wild":{"species":146,"level":60},"music":"MUSIC_LEGEND","environment":"city"},"onWin":[{"setFlag":"GANDA_DONE"},{"if":{"caught":146},"then":[{"say":"Gandaberunda bows both heads. It will protect the land at your side."}],"else":[{"say":"Gandaberunda soars over the dome and fades into the seal."}]}],"onLose":[]}]}],"counters":[],"interactables":[],"encounters":{},"water":[],"onEnter":null,"spawn":null,"metroStation":null,"respawnText":null}}
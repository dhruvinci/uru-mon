WANDER","script":[{"say":"Morning walkers own this garden before seven. After that it's the photographers."}]},{"id":"lb_kid","x":38,"y":36,"sprite":"kid2","facing":"DOWN","movement":"WANDER","wanderRadius":1,"script":[{"say":"I saw a Gulmo in the grass by the lake! It ran off when I sneezed."}]},{"id":"gaala_ajja","x":32,"y":29,"sprite":"ajja","facing":"DOWN","movement":"IDLE","script":[{"if":"GOT_GAALA","then":[{"say":["Face the water and press A to cast. Be patient. The lake gives to those who wait.","Bigger lakes up north hide bigger Urumon. Some say even something from the temple carvings."],"speaker":"Fisherman Ajja"}],"else":[{"say":["Sixty years I've fished this lake. Back then the water was so clear you could count the pebbles.","You look like you have patience, kanda. Here - my spare rod."],"speaker":"Fisherman Ajja"},{"giveItem":"Gaala"},{"setFlag":"GOT_GAALA"},{"say":"Stand at the edge, face the water and press A. Every lake has its own Urumon.","speaker":"Fisherman Ajja"}]}]},{"id":"lb_gardener","x":17,"y":7,"sprite":"gardener","facing":"LEFT","movement":"IDLE","script":[{"say":["Two hundred and forty flower beds, and Hoovamma knows if one petal is out of place.","Don't step on the marigolds. They bite. ...No, they don't. But Hoovamma does."]}]},{"id":"lb_photo","x":10,"y":9,"sprite":"college_m","facing":"UP","movement":"IDLE","script":[{"say":"I'm doing a time-lapse of the floral clock. Twelve hours of footage. Very exciting. Very... slow."}]},{"id":"lb_icecream","x":19,"y":19,"sprite":"vendor","facing":"DOWN","movement":"IDLE","script":[{"say":"Ice cream! Kulfi! Mango, pista, and 'chikoo surprise'. The surprise is that it's chikoo."}]},{"id":"lb_lover","x":36,"y":23,"sprite":"woman1","facing":"DOWN","movement":"IDLE","script":[{"say":"We had our first date on this bench. He brought me a bonsai. It's still alive. He's on thin ice."}]}],"signs":[{"x":24,"y":15,"text":"LALBAGH BOTANICAL GARDEN - Home of the Glass House Arena. Leader: Hoovamma."},{"x":31,"y":10,"text":"LALBAGH ROCK - Over 3,000 million years old. Older than every Urumon. Probably."},{"x":25,"y":22,"text":"Please do not feed the lake Urumon. They have very specific diets."},{"x":12,"y":9,"style":"board","text":"THE FLORAL CLOCK. Keeps perfect time, except when the gardeners are watering it."},{"x":11,"y":27,"style":"metro","text":"NAMMA METRO - Lalbagh station. Green Line."}],"items":[{"id":"dosa1","x":38,"y":7,"item":"Masala Dosa"},{"id":"coil1","x":19,"y":36,"item":"Mosquito Coil"}],"triggers":[],"counters":[],"interactables":[],"encounters":{"grass":{"rate":0.12,"slots":[{"species":54,"min":5,"max":7,"weight":18},{"species":52,"min":5,"max":7,"weight":15},{"species":15,"min":4,"max":6,"weight":15},{"species":74,"min":5,"max":7,"weight":14},{"species":10,"min":5,"max":7,"weight":10},{"species":22,"min":5,"max":6,"weight":8},{"species":76,"min":5,"max":6,"weight":8},{"species":78,"min":6,"max":7,"weight":6},{"species":112,"min":6,"max":7,"weight":4},{"species":80,"min":7,"max":7,"weight":2}]},"fish":{"rate":1,"slots":[{"species":24,"min":5,"max":8,"weight":40},{"species":81,"min":5,"max":7,"weight":30},{"species":22,"min":5,"max":7,"weight":20},{"species":45,"min":6,"max":8,"weight":10}]}},"water":[1087,1130,1131,1133,1134,1135,1136,1171,1172,1173,1174,1175,1177,1178,1179,1180,1181,1215,1216,1217,1218,1219,1221,1222,1223,1224,1225,1226,1259,1260,1261,1262,1263,1265,1266,1267,1268,1269,1270,1271,1303,1304,1305,1306,1310,1311,1312,1313,1314,1315,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1391,1392,1393,1394,1395,1396,1397,1398,1399,1400,1401,1402,1435,1436,1437,1438,1439,1440,1441,1442,1443,1444,1445,1446,1480,1481,1482,1483,1484,1485,1486,1487,1488,1489,1525,1526,1527,1528,1529,1530,1531,1532,1571,1575],"lights":[{"x":19,"y":13,"size":3.2,"tint":16767120},{"x":24,"y":13,"size":3.2,"tint":16767120},{"x":3,"y":18,"size":3.2,"tint":16767120},{"x":24,"y":22,"size":3.2,"tint":16767120}],"onEnter":null,"spawn":null,"metroStation"
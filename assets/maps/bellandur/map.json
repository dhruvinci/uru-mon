g","value":"grass"},{"name":"tileType","type":"string","value":"GRASS"}]}],"tilesets":[{"firstgid":1,"name":"collision","tilewidth":64,"tileheight":64,"tilecount":1,"columns":1,"image":"collision.png","imagewidth":64,"imageheight":64,"margin":0,"spacing":0},{"firstgid":2,"name":"encounter","tilewidth":64,"tileheight":64,"tilecount":1,"columns":1,"image":"encounter.png","imagewidth":64,"imageheight":64,"margin":0,"spacing":0}],"uru":{"id":"bellandur","name":"Bellandur Lake","music":"MUSIC_SYNDICATE","environment":"lake","interior":false,"warps":[{"id":"site","to":"bellandur_site","toId":"door","x":10,"y":7,"exit":"DOWN","dir":"UP"},{"id":"site__1","to":"bellandur_site","toId":"door","x":11,"y":7,"exit":"DOWN","dir":"UP"},{"id":"N0","x":18,"y":0,"to":"whitefield","toId":"S0","exit":"DOWN","dir":"UP"},{"id":"N1","x":19,"y":0,"to":"whitefield","toId":"S1","exit":"DOWN","dir":"UP"}],"npcs":[{"id":"t_bl_grunt1","x":15,"y":9,"sprite":"grunt_m","facing":"RIGHT","trainer":"grunt_bell1","sight":3,"movement":"IDLE"},{"id":"t_bl_grunt2","x":26,"y":13,"sprite":"grunt_f","facing":"LEFT","trainer":"grunt_bell2","sight":4,"movement":"IDLE"},{"id":"t_bl_grunt3","x":6,"y":22,"sprite":"grunt_m","facing":"UP","trainer":"grunt_bell3","sight":4,"movement":"IDLE"},{"id":"t_bl_fisher","x":16,"y":30,"sprite":"fisher","facing":"UP","trainer":"bl_fisher","sight":3,"movement":"IDLE"},{"id":"bl_officer","x":21,"y":12,"sprite":"rowdy","facing":"DOWN","movement":"IDLE","showIf":"BELLANDUR_ADMIN_DONE","hideIf":"BELLANDUR_DONE","script":[]},{"id":"bl_resident","x":30,"y":10,"sprite":"woman4","facing":"DOWN","movement":"IDLE","script":[{"if":"BELLANDUR_DONE","then":[{"say":"The pipes are shut and the foam is settling! I could cry. I might cry."}],"else":[{"say":["My flat overlooks the lake. Every morning the foam is a little higher.","Last week a foam monster rose out of it and floated past my balcony. I'm not joking!"]}]}]}],"signs":[{"x":20,"y":10,"text":"BELLANDUR LAKE. Once the city's largest lake. Now the city's largest bubble bath."},{"x":14,"y":10,"text":"CONCRETE SYNDICATE - SITE OFFICE. Keep out. We are building the future (of parking)."}],"items":[{"id":"elaneer1","x":3,"y":13,"item":"Elaneer","qty":2},{"id":"tiffin1","x":32,"y":33,"item":"Tiffin Carrier"}],"triggers":[{"id":"metro_reward","x":8,"y":8,"w":6,"h":3,"requires":"BELLANDUR_ADMIN_DONE","unless":"BELLANDUR_DONE","script":[{"npcToPlayer":"bl_officer"},{"say":["Oi! You're the kid who shut down the foam factory? I'm Rangappa. Everyone calls me Rowdy Rangappa.","This lake is MY area. Thirty years I've swum here. Those Syndicate fellows thought they could dump in it?","You did what I couldn't, and without breaking a single head. Respect, chikka. Take this."],"speaker":"Rowdy Rangappa"},{"giveItem":"Metro Card"},{"say":["A Metro Card. Tap it at any Namma Metro station. My nephew works at the Metro office - don't ask questions.","And that barricade north of MG Road? Consider it gone. Nobody blocks a friend of Rangappa.","That Admin kept muttering about 'the hills' and 'sunrise'. If they go to Nandi, you go too. Give them one from me."],"speaker":"Rowdy Rangappa"},{"setFlag":"BELLANDUR_DONE"},{"npcWalk":{"id":"bl_officer","steps":["UP","UP","UP","UP"],"ghost":true}},{"npcHide":"bl_officer"}]}],"counters":[],"interactables":[{"x":21,"y":15,"requires":{"not":"FOAM_SPIRIT_DONE"},"script":[{"say":"The foam is churning... something huge is rising out of it!"},{"battle":{"wild":{"species":23,"level":26},"music":"MUSIC_LEGEND"},"onWin":[{"setFlag":"FOAM_SPIRIT_DONE"}],"onLose":[]},{"setFlag":"FOAM_SPIRIT_DONE"}]}],"encounters":{"grass":{"rate":0.13,"slots":[{"species":22,"min":19,"max":23,"weight":22},{"species":108,"min":19,"max":22,"weight":14},{"species":18,"min":19,"max":23,"weight":14},{"species":45,"min":19,"max":22,"weight":12},{"species":24,"min":19,"max":23,"weight":10},{"species":43,"min":19,"max":22,"weight":8},{"species":20,"min":20,"max":23,"weight":8},{"species":102,"min":20,"max":23,"weight
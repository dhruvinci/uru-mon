icer","x":21,"y":12,"sprite":"rowdy","facing":"DOWN","movement":"IDLE","showIf":"BELLANDUR_ADMIN_DONE","hideIf":"BELLANDUR_DONE","script":[]},{"id":"bl_resident","x":30,"y":10,"sprite":"woman4","facing":"DOWN","movement":"IDLE","script":[{"if":"BELLANDUR_DONE","then":[{"say":"The pipes are shut and the foam is settling! I could cry. I might cry."}],"else":[{"say":["My flat overlooks the lake. Every morning the foam is a little higher.","Last week a foam monster rose out of it and floated past my balcony. I'm not joking!"]}]}]},{"id":"bl_activist","x":24,"y":10,"sprite":"college_f","facing":"DOWN","movement":"IDLE","script":[{"say":"We've written to the city four hundred times. The fish have written too. Well, the ones that are left."}]},{"id":"bl_birder","x":36,"y":29,"sprite":"birdwatcher","facing":"LEFT","movement":"IDLE","script":[{"say":"Purple herons still nest in the reeds, foam and all. Stubborn birds. I like them."}]}],"signs":[{"x":20,"y":10,"text":"BELLANDUR LAKE. Once the city's largest lake. Now the city's largest bubble bath."},{"x":15,"y":10,"text":"CONCRETE SYNDICATE - SITE OFFICE. Keep out. We are building the future (of parking)."}],"items":[{"id":"elaneer1","x":3,"y":14,"item":"Elaneer","qty":2},{"id":"tiffin1","x":32,"y":34,"item":"Tiffin Carrier"}],"triggers":[{"id":"metro_reward","x":8,"y":8,"w":6,"h":3,"requires":"BELLANDUR_ADMIN_DONE","unless":"BELLANDUR_DONE","script":[{"npcToPlayer":"bl_officer"},{"say":["Oi! You're the kid who shut down the foam factory? I'm Rangappa. Everyone calls me Rowdy Rangappa.","This lake is MY area. Thirty years I've swum here. Those Syndicate fellows thought they could dump in it?","You did what I couldn't, and without breaking a single head. Respect, chikka. Take this."],"speaker":"Rowdy Rangappa"},{"giveItem":"Metro Card"},{"say":["A Metro Card. Tap it at any Namma Metro station. My nephew works at the Metro office - don't ask questions.","And that barricade north of MG Road? Consider it gone. Nobody blocks a friend of Rangappa.","That Admin kept muttering about 'the hills' and 'sunrise'. If they go to Nandi, you go too. Give them one from me."],"speaker":"Rowdy Rangappa"},{"setFlag":"BELLANDUR_DONE"},{"npcWalk":{"id":"bl_officer","steps":["UP","UP","UP","UP"],"ghost":true}},{"npcHide":"bl_officer"}]}],"counters":[],"interactables":[{"x":21,"y":15,"requires":{"not":"FOAM_SPIRIT_DONE"},"script":[{"say":"The foam is churning... something huge is rising out of it!"},{"battle":{"wild":{"species":23,"level":26},"music":"MUSIC_LEGEND"},"onWin":[{"setFlag":"FOAM_SPIRIT_DONE"}],"onLose":[]},{"setFlag":"FOAM_SPIRIT_DONE"}]}],"encounters":{"grass":{"rate":0.13,"slots":[{"species":22,"min":19,"max":23,"weight":22},{"species":108,"min":19,"max":22,"weight":14},{"species":18,"min":19,"max":23,"weight":14},{"species":45,"min":19,"max":22,"weight":12},{"species":24,"min":19,"max":23,"weight":10},{"species":43,"min":19,"max":22,"weight":8},{"species":20,"min":20,"max":23,"weight":8},{"species":102,"min":20,"max":23,"weight":8}]},"fish":{"rate":1,"slots":[{"species":22,"min":19,"max":23,"weight":35},{"species":24,"min":19,"max":23,"weight":25},{"species":110,"min":19,"max":22,"weight":25},{"species":45,"min":20,"max":23,"weight":15}]}},"water":[615,616,617,618,619,620,621,622,623,624,625,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,886,887,888,889,890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909,910,911,912,913,914,925,926,927,928,929